{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/agentops/specs/013-billed-cost-allocation/contracts/cost-model.schema.json",
  "title": "AgentOps Cost Model",
  "description": "Versioned, non-secret operator configuration for allocating declared billed totals over observed usage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "periods"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/costPeriod"
      }
    }
  },
  "$comment": "Cross-period component ID uniqueness and non-overlap for the same billing boundary are enforced by model validation because JSON Schema cannot compare sibling intervals.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "nonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$"
    },
    "boundedSelector": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "default": []
    },
    "billingBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "resource",
            "subscription",
            "account",
            "pool",
            "custom"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "default": null
        }
      }
    },
    "usageMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_resource_ids": {
          "$ref": "#/$defs/boundedSelector"
        },
        "project_resource_ids": {
          "$ref": "#/$defs/boundedSelector"
        },
        "agent_keys": {
          "$ref": "#/$defs/boundedSelector"
        },
        "deployments": {
          "$ref": "#/$defs/boundedSelector"
        },
        "models": {
          "$ref": "#/$defs/boundedSelector"
        },
        "tool_names": {
          "$ref": "#/$defs/boundedSelector"
        },
        "runtime_kinds": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "foundry_hosted",
              "foundry_prompt",
              "external_registered",
              "external_unregistered",
              "copilot_studio",
              "unknown"
            ]
          },
          "default": []
        },
        "credit_event_operations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "default": []
        }
      },
      "anyOf": [
        {
          "required": [
            "source_resource_ids"
          ],
          "properties": {
            "source_resource_ids": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "project_resource_ids"
          ],
          "properties": {
            "project_resource_ids": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "agent_keys"
          ],
          "properties": {
            "agent_keys": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "deployments"
          ],
          "properties": {
            "deployments": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "models"
          ],
          "properties": {
            "models": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "tool_names"
          ],
          "properties": {
            "tool_names": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "runtime_kinds"
          ],
          "properties": {
            "runtime_kinds": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "tokenWeights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "oneOf": [
            {
              "$ref": "#/$defs/positiveDecimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "oneOf": [
            {
              "$ref": "#/$defs/positiveDecimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_read_tokens": {
          "oneOf": [
            {
              "$ref": "#/$defs/positiveDecimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_write_tokens": {
          "oneOf": [
            {
              "$ref": "#/$defs/positiveDecimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_tokens": {
          "oneOf": [
            {
              "$ref": "#/$defs/positiveDecimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "input_tokens"
          ],
          "properties": {
            "input_tokens": {
              "$ref": "#/$defs/positiveDecimal"
            }
          }
        },
        {
          "required": [
            "output_tokens"
          ],
          "properties": {
            "output_tokens": {
              "$ref": "#/$defs/positiveDecimal"
            }
          }
        },
        {
          "required": [
            "cache_read_tokens"
          ],
          "properties": {
            "cache_read_tokens": {
              "$ref": "#/$defs/positiveDecimal"
            }
          }
        },
        {
          "required": [
            "cache_write_tokens"
          ],
          "properties": {
            "cache_write_tokens": {
              "$ref": "#/$defs/positiveDecimal"
            }
          }
        },
        {
          "required": [
            "reasoning_tokens"
          ],
          "properties": {
            "reasoning_tokens": {
              "$ref": "#/$defs/positiveDecimal"
            }
          }
        }
      ]
    },
    "costComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "billing_boundary",
        "billed_source",
        "billed_total",
        "currency",
        "currency_minor_units",
        "allocation_model",
        "allocation_key",
        "usage_match"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "provisioned_throughput",
            "standard_model",
            "search",
            "grounding",
            "content_safety",
            "storage",
            "hosted_compute",
            "customer_compute",
            "credit_payg",
            "credit_prepaid"
          ]
        },
        "billing_boundary": {
          "$ref": "#/$defs/billingBoundary"
        },
        "billed_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "billed_total": {
          "$ref": "#/$defs/nonNegativeDecimal"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "currency_minor_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "allocation_model": {
          "enum": [
            "metered",
            "commitment"
          ]
        },
        "allocation_key": {
          "enum": [
            "weighted_tokens",
            "total_tokens",
            "tool_invocations",
            "active_session_seconds",
            "credits",
            "credit_events"
          ]
        },
        "fallback_key": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "total_tokens",
            "credit_events",
            null
          ],
          "default": null
        },
        "token_weights": {
          "oneOf": [
            {
              "$ref": "#/$defs/tokenWeights"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "usage_match": {
          "$ref": "#/$defs/usageMatch"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allocation_key": {
                "enum": [
                  "total_tokens",
                  "tool_invocations",
                  "active_session_seconds",
                  "credit_events"
                ]
              }
            },
            "required": [
              "allocation_key"
            ]
          },
          "then": {
            "properties": {
              "fallback_key": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "allocation_key": {
                    "const": "credit_events"
                  }
                },
                "required": [
                  "allocation_key"
                ]
              },
              {
                "properties": {
                  "fallback_key": {
                    "const": "credit_events"
                  }
                },
                "required": [
                  "fallback_key"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "usage_match": {
                "required": [
                  "credit_event_operations"
                ],
                "properties": {
                  "credit_event_operations": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "allocation_key": {
                      "const": "credit_events"
                    }
                  },
                  "required": [
                    "allocation_key"
                  ]
                },
                {
                  "properties": {
                    "fallback_key": {
                      "const": "credit_events"
                    }
                  },
                  "required": [
                    "fallback_key"
                  ]
                }
              ]
            }
          },
          "then": {
            "properties": {
              "usage_match": {
                "properties": {
                  "credit_event_operations": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "currency_minor_units": {
                "const": 0
              }
            },
            "required": [
              "currency_minor_units"
            ]
          },
          "then": {
            "properties": {
              "billed_total": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "currency_minor_units": {
                "const": 1
              }
            },
            "required": [
              "currency_minor_units"
            ]
          },
          "then": {
            "properties": {
              "billed_total": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9])?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "currency_minor_units": {
                "const": 2
              }
            },
            "required": [
              "currency_minor_units"
            ]
          },
          "then": {
            "properties": {
              "billed_total": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "currency_minor_units": {
                "const": 3
              }
            },
            "required": [
              "currency_minor_units"
            ]
          },
          "then": {
            "properties": {
              "billed_total": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "currency_minor_units": {
                "const": 4
              }
            },
            "required": [
              "currency_minor_units"
            ]
          },
          "then": {
            "properties": {
              "billed_total": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "currency_minor_units": {
                "const": 5
              }
            },
            "required": [
              "currency_minor_units"
            ]
          },
          "then": {
            "properties": {
              "billed_total": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,5})?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "currency_minor_units": {
                "const": 6
              }
            },
            "required": [
              "currency_minor_units"
            ]
          },
          "then": {
            "properties": {
              "billed_total": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allocation_key": {
                "const": "weighted_tokens"
              }
            },
            "required": [
              "allocation_key"
            ]
          },
          "then": {
            "required": [
              "token_weights"
            ],
            "properties": {
              "token_weights": {
                "$ref": "#/$defs/tokenWeights"
              },
              "fallback_key": {
                "enum": [
                  "total_tokens",
                  null
                ]
              }
            }
          },
          "else": {
            "properties": {
              "token_weights": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "provisioned_throughput"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "allocation_model": {
                "const": "commitment"
              },
              "allocation_key": {
                "enum": [
                  "weighted_tokens",
                  "total_tokens"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "standard_model"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "allocation_model": {
                "const": "metered"
              },
              "allocation_key": {
                "enum": [
                  "weighted_tokens",
                  "total_tokens"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "search",
                  "grounding",
                  "content_safety",
                  "storage"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "allocation_model": {
                "const": "metered"
              },
              "allocation_key": {
                "const": "tool_invocations"
              },
              "fallback_key": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hosted_compute"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "allocation_model": {
                "const": "metered"
              },
              "allocation_key": {
                "const": "active_session_seconds"
              },
              "fallback_key": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "customer_compute"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "allocation_key": {
                "const": "active_session_seconds"
              },
              "fallback_key": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "credit_payg"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "allocation_model": {
                "const": "metered"
              },
              "allocation_key": {
                "enum": [
                  "credits",
                  "credit_events"
                ]
              },
              "fallback_key": {
                "enum": [
                  "credit_events",
                  null
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "credit_prepaid"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "allocation_model": {
                "const": "commitment"
              },
              "allocation_key": {
                "enum": [
                  "credits",
                  "credit_events"
                ]
              },
              "fallback_key": {
                "enum": [
                  "credit_events",
                  null
                ]
              }
            }
          }
        }
      ]
    },
    "costPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "starts_at",
        "ends_at",
        "components"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/costComponent"
          }
        }
      },
      "$comment": "The model validator enforces ends_at > starts_at and unique component IDs."
    }
  }
}
